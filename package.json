{
  "name": "Tally",
  "main": "expo/AppEntry",
  "version": "0.1.0",
  "scripts": {
    "start": "expo start",
    "test:onboarding": "node --test modules/Onboarding/__tests__/*.test.cjs",
    "test:analytics": "node --test modules/Insights/__tests__/*.test.cjs",
    "android": "expo run:android",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "test:import": "node --test hooks/__tests__/transaction-import.test.cjs",
    "test:categories": "node --test hooks/__tests__/category-*.test.cjs",
    "test:notifications": "node --test hooks/__tests__/notifications.test.cjs",
    "test:release": "node --test scripts/__tests__/*.test.cjs",
    "check:release": "npm run typecheck && npm run lint && npm run test:onboarding && npm run test:analytics && npm run test:import && npm run test:categories && npm run test:notifications && npm run test:release",
    "build:android:release": "node scripts/build-android-release.mjs",
    "check:fonts": "node scripts/check-fonts.mjs",
    "prestart": "npm run check:fonts",
    "preandroid": "npm run check:fonts",
    "preios": "npm run check:fonts"
  },
  "dependencies": {
    "@craftzdog/react-native-buffer": "^6.1.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "^8.4.4",
    "@react-native-community/slider": "5.0.1",
    "@react-navigation/native": "^7.2.0",
    "@react-navigation/native-stack": "^7.14.12",
    "@reduxjs/toolkit": "^2.9.0",
    "color": "^5.0.2",
    "expo": "~54.0.33",
    "expo-asset": "~12.0.13",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.8",
    "expo-dev-client": "~6.0.21",
    "expo-document-picker": "~14.0.3",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-local-authentication": "~17.0.8",
    "expo-navigation-bar": "~5.0.10",
    "expo-notifications": "~0.32.17",
    "expo-print": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-calendars": "^1.1314.0",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-keyboard-controller": "^1.18.5",
    "react-native-mmkv": "^4.3.1",
    "react-native-paper": "^5.15.0",
    "react-native-quick-crypto": "^1.1.5",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-worklets": "0.5.1",
    "react-redux": "^9.2.0",
    "readable-stream": "^4.7.0",
    "reanimated-color-picker": "^4.2.0",
    "use-debounce": "^10.1.1"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "typescript": "~5.9.2"
  },
  "private": true,
  "license": "GPL-3.0-only"
}
